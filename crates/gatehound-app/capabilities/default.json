{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "The main window drives the gateway through IPC commands and listens for its events; nothing else is granted.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:event:default",
    "notification:default",
    "dialog:allow-message",
    "opener:default"
  ]
}
