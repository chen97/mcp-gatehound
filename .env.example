# Secrets and per-machine settings. Everything here overrides gatehound.toml.
# The gateway loads .env from the working directory, or DOTENV_PATH if set.

# ---- the two auth factors (SPEC §4.2) ----
GATEHOUND_TOKEN=              # openssl rand -hex 32 ; the same value goes into the Worker
CF_ACCESS_TEAM_DOMAIN=        # yourteam.cloudflareaccess.com
CF_ACCESS_AUD=                # the Access application's AUD tag
# ALLOWED_EMAILS=you@example.com,message-desk

# ---- Beeper Desktop (laptop) ----
BEEPER_ACCESS_TOKEN=          # Beeper Desktop → Settings → Developers → new token
BEEPER_API_URL=http://localhost:23373

# ---- listener ----
LISTEN_ADDR=127.0.0.1:8790    # loopback only; cloudflared publishes it
# DB_PATH=
APPROVAL_TIMEOUT_SECS=60
LOG_RETENTION_DAYS=30

# ---- drafting: your Claude subscription (default) ----
DRAFT_PROVIDER=claude-cli
CLAUDE_BIN=claude
VOICE_FILE=voice.md
CONTEXT_MESSAGES=20
# --- or pay per token instead: ---
# DRAFT_PROVIDER=api
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- which chats are surfaced ----
LOOKBACK_MINUTES=120
INCLUDE_GROUPS=false
INCLUDE_MUTED=false
ONLY_UNREAD=false
MARK_READ_ON_SEND=true
SEND_LIMIT_PER_HOUR=60
# ALLOW_CHAT_IDS=
# IGNORE_CHAT_IDS=
