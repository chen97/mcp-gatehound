# Copy to .env and fill in. The gateway reads this file at startup; environment variables always
# win over gatehound.toml, so a service unit can adjust a deployment without editing config.

# Required. The bearer token every caller must present.
#   openssl rand -hex 32
GATEHOUND_TOKEN=

# Cloudflare Access — the second factor. Both are needed for the check to be enforced.
CF_ACCESS_TEAM_DOMAIN=myteam.cloudflareaccess.com
CF_ACCESS_AUD=

# Optional allow-list for the Access identity, comma-separated. An email for a human, a service
# token's common name for a machine. Empty means any identity Access already let through.
ALLOWED_EMAILS=

# Upstream credentials. Each upstream in gatehound.toml names its own variable via `token_env`;
# these match the example config.
TRACKER_TOKEN=
# SEARCH_TOKEN=

# Optional overrides for what is already in gatehound.toml.
# LISTEN_ADDR=127.0.0.1:8790
# DB_PATH=~/.gatehound/gatehound.db
# APPROVAL_TIMEOUT_SECS=60
# LOG_RETENTION_DAYS=30
# SEND_LIMIT_PER_HOUR=60
